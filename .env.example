# Copy with npm run setup. No credentials belong in browser code.
HOST=127.0.0.1
PORT=4180
APP_URL=http://localhost:4180
STORE_NAME=订阅集 SubNest
PRODSELLER_MODE=demo
PRODSELLER_API_KEY=
# 1 USDT cost -> CNY retail price; change deliberately before going live.
USDT_CNY_RATE=7.2
MARKUP_PERCENT=25
CATALOG_SYNC_MINUTES=10
# demo | manual. Demo payment is forbidden with a live supplier.
PAYMENT_MODE=demo
MANUAL_PAYMENT_INSTRUCTIONS=
SUPPORT_EMAIL=
ADMIN_PASSWORD=
# Generate a random 32-byte hex key. Keep it and back up with the database.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/store.sqlite
# Set COOKIE_SECURE=true and APP_URL=https://your-domain for HTTPS deployment.
COOKIE_SECURE=false
# Number of trusted reverse-proxy hops; direct hosting should use 0.
TRUST_PROXY=0
SUPPORT_WECHAT=support_wechat
SUPPORT_TELEGRAM=t.me/support_contact
AIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
AIPAY_APP_ID=
AIPAY_PUBLIC_KEY=
AIPAY_PRIVATE_KEY=
AIPAY_PRIVATE_PKCS_KEY=
AIPAY_ALIPAY_PUBLIC_KEY=
